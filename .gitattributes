# Build output and vendored files.
#
# The root skills/ directory is what `npx skills add e0ipso/strikethroo`
# installs. It is generated: the release rebuilds it from src/skill-scripts/
# and src/skill-prompts/ (`npm run build:release-skills`) and commits it
# through `@semantic-release/git`. Local builds write dist-test/ instead,
# which is gitignored. Marking the mirror generated gives two behaviours:
#
#   - GitHub collapses it in pull requests, so a reviewer sees source rather
#     than generated churn.
#   - The code review gate excludes it from the reviewed diff. It resolves
#     attributes with `git check-attr` on changed paths, and a fix applied to
#     build output is erased by the next release.
#
# Change the source, never these files. `.husky/pre-commit` rejects them when
# staged by hand, and CI fails when skills/ differs from the last release tag.

# Assembled by scripts/build-skill-prompts.cjs from src/skill-prompts/.
skills/*/SKILL.md linguist-generated=true

# Bundled by scripts/build-skills.cjs (esbuild) from src/skill-scripts/.
skills/*/scripts/*.cjs linguist-generated=true

# Copied by scripts/build-skill-prompts.cjs from src/skill-prompts/skills/<name>/references/.
skills/*/references/*.md linguist-generated=true

# Vendored verbatim from e0ipso/self-review (MIT). Must stay byte-identical to
# upstream, so it is never a legitimate target for a review finding.
templates/strikethroo/config/schemas/*.xsd linguist-vendored=true
