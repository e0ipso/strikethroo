# Build output and vendored files.
#
# The skill artifacts (bundles, assembled prompts, and copied references) exist
# in two trees. `templates/harness/skills/` is local build output and is
# gitignored; the tracked root `skills/` mirror records the last released
# build, written only by the release workflow's sync step
# (`scripts/sync-skills-mirror.cjs`) and committed through `@semantic-release/git`.
# Both are generated, so both are marked here, which gives two behaviours:
#
#   - GitHub collapses them in pull requests, so a reviewer sees source rather
#     than generated churn.
#   - The code review gate excludes them from the reviewed diff. It resolves
#     attributes with `git check-attr` on changed paths, and a fix applied to
#     build output is erased by the next `npm run build` or mirror sync.
#
# Change the source, never these files. `.husky/pre-commit` rejects them when
# staged by hand.

# Assembled by scripts/build-skill-prompts.cjs from src/skill-prompts/.
templates/harness/skills/*/SKILL.md linguist-generated=true

# Bundled by scripts/build-skills.cjs (esbuild) from src/skill-scripts/.
templates/harness/skills/*/scripts/*.cjs linguist-generated=true

# Copied by scripts/build-skill-prompts.cjs from src/skill-prompts/skills/<name>/references/.
templates/harness/skills/*/references/*.md linguist-generated=true

# Released mirror of the two trees above, synced by scripts/sync-skills-mirror.cjs.
skills/*/SKILL.md linguist-generated=true
skills/*/scripts/*.cjs linguist-generated=true
skills/*/references/*.md linguist-generated=true

# Vendored verbatim from e0ipso/self-review (MIT). Must stay byte-identical to
# upstream, so it is never a legitimate target for a review finding.
templates/strikethroo/config/schemas/*.xsd linguist-vendored=true
