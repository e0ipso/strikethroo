# Build output and vendored files that a diff should not present as source.
#
# The skill artifacts under templates/harness/skills/ are gitignored and no
# longer tracked at any ref — they ship in the npm tarball. The markers still
# apply, because `git check-attr` resolves attributes from these rules alone,
# independently of whether a path is tracked:
#
#   - The code review gate drops them from the reviewed diff. A finding against
#     build output is unactionable by construction: the mandatory POST_EXECUTION
#     rebuild regenerates the file and erases the fix.
#   - GitHub collapses them in pull requests if they ever surface in one, so a
#     reviewer sees source rather than generated churn.
#
# Change the source, never these files. `.husky/pre-commit` rejects them when
# staged by hand.

# Assembled by scripts/build-skill-prompts.cjs from src/skill-prompts/.
templates/harness/skills/*/SKILL.md linguist-generated=true

# Bundled by scripts/build-skills.cjs (esbuild) from src/skill-scripts/.
templates/harness/skills/*/scripts/*.cjs linguist-generated=true

# Vendored verbatim from e0ipso/self-review (MIT). Must stay byte-identical to
# upstream, so it is never a legitimate target for a review finding.
templates/strikethroo/config/schemas/*.xsd linguist-vendored=true
