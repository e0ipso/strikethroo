# Generated skill artifacts are gitignored build output. They ship to users in
# the npm tarball that `strikethroo init` installs from, not from this git
# tree, which no longer carries them at any ref. So they are never legitimately
# tracked here: anything matching these globs in the index arrived through an
# explicit `git add -f` and is a mistake.
#
# Deletions are excluded (--diff-filter=d, lowercase d): removing a tracked
# copy is always the right direction, and the commit that untracked these
# paths had to be possible without --no-verify.
#
# Both the esbuild bundles and the assembled SKILL.md files are covered:
# each is overwritten wholesale by `npm run build`, so a change made to
# either is lost at the next build. Edit the source instead —
# src/skill-scripts/ for the bundles, src/skill-prompts/ for the prompts.
# They are marked linguist-generated in .gitattributes for the same reason.
staged_artifacts=$(git diff --cached --name-only --diff-filter=d -- \
  'templates/harness/skills/*/scripts/*.cjs' \
  'templates/harness/skills/*/SKILL.md')
if [ -n "$staged_artifacts" ]; then
  echo "✗ Generated skill artifacts are staged; they are gitignored build output that ships in the npm tarball, not from git:" >&2
  echo "$staged_artifacts" >&2
  echo "Edit the source instead: src/skill-scripts/ (bundles) or src/skill-prompts/ (prompts)." >&2
  echo "Unstage with:" >&2
  echo "  git restore --staged 'templates/harness/skills/*/scripts/*.cjs' 'templates/harness/skills/*/SKILL.md'" >&2
  exit 1
fi

npx lint-staged
npm test
