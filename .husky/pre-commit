# The root skills/ directory is generated and released, never edited by hand.
# The release workflow rebuilds it from src/skill-scripts/ and src/skill-prompts/
# with `npm run build:release-skills` and commits it; it runs with HUSKY=0, so
# this guard never blocks the release commit. Local builds write dist-test/,
# which is gitignored, so nothing here should ever be staged by a person.
#
# --diff-filter=d excludes deletions: dropping generated files from the index is
# always legitimate, so only added or modified content is rejected.
staged_artifacts=$(git diff --cached --name-only --diff-filter=d -- \
  'skills/*/SKILL.md' \
  'skills/*/scripts/*.cjs' \
  'skills/*/references/*.md')
if [ -n "$staged_artifacts" ]; then
  echo "✗ Generated skill artifacts are staged:" >&2
  echo "$staged_artifacts" >&2
  echo "skills/ is written only by the release. Anything staged here is overwritten." >&2
  echo "Edit the source instead: src/skill-scripts/ (bundles) or src/skill-prompts/ (prompts)." >&2
  echo "Unstage each path above with: git restore --staged <path>" >&2
  exit 1
fi

npx lint-staged
npm test
